<?xml version="1.0" encoding="UTF-8"?>
<!-- Kerf for After Effects: the same Kerf UI as the Premiere panel, as an HTML (CEP) panel. Window > Extensions > Kerf.
     scripts/build_cep.py assembles it: ui/ = the built Kerf UI (ui/dist), Kerf.jsx + host.jsx = the After Effects tools. -->
<ExtensionManifest Version="7.0" ExtensionBundleId="com.kerf.aftereffects" ExtensionBundleVersion="0.3.0" ExtensionBundleName="Kerf"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.kerf.aftereffects.panel" Version="0.3.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[22.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.kerf.aftereffects.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./ui/index.html</MainPath>
          <ScriptPath>./host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Kerf</Menu>
          <Geometry>
            <Size><Height>760</Height><Width>420</Width></Size>
            <MinSize><Height>280</Height><Width>300</Width></MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
