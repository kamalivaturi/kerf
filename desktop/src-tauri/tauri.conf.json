{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kerf",
  "version": "0.3.1",
  "identifier": "com.kerf.studio",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Kerf",
    "copyright": "MIT License",
    "category": "Video",
    "shortDescription": "Kerf for Premiere Pro, After Effects and DaVinci Resolve",
    "longDescription": "Kerf adds an AI editing panel to Premiere Pro, After Effects and DaVinci Resolve: silence cuts, captions, zooms, shakes, speed ramps, stabilizer, offline AI cutouts and more. This installer sets up the local engine and the panels; there is no separate app to open.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../engine-dist/kerf-engine/": "engine/",
      "../../build/panels/": "panels/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzNDYzQUFERTgzNzRERjQKUldUMFRUZm9yVHBHSTdKamQrUk4wTXJMa1h0VUZxVGltZEQ5cEpFL1gycnpwUHc1THgwK0xVZGcK",
      "endpoints": [
        "https://github.com/kamalivaturi/kerf/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "kerf"
}
