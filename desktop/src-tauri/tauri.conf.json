{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kerf Studio",
  "version": "0.2.0",
  "identifier": "com.kerf.studio",
  "build": { "frontendDist": "../splash" },
  "app": {
    "windows": [
      { "title": "Kerf Studio", "width": 820, "height": 980, "minWidth": 420, "minHeight": 600, "backgroundColor": "#140f0c" }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Kerf",
    "copyright": "MIT License",
    "category": "Video",
    "shortDescription": "AI editing toolkit for Premiere Pro, After Effects and DaVinci Resolve",
    "longDescription": "Kerf Studio runs the Kerf engine locally: silence cuts, captions, MOGRT templates, speed ramps, camera shakes, stabilizer, offline AI cutouts and more, for Premiere Pro, After Effects and DaVinci Resolve.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "../../engine-dist/kerf-engine/": "engine/" },
    "macOS": { "minimumSystemVersion": "11.0" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
