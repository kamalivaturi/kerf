{
  "id": "com.kerf.editor",
  "name": "Kerf",
  "version": "0.1.1",
  "main": "index.html",
  "manifestVersion": 5,
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": { "domains": ["http://127.0.0.1:7878", "http://localhost:7878"] },
    "launchProcess": { "schemes": ["https"], "extensions": [".cmd", ".command"] },
    "clipboard": "readAndWrite"
  },
  "entrypoints": [
    {
      "id": "kerf.panel",
      "type": "panel",
      "label": { "default": "Kerf" },
      "minimumSize": { "width": 300, "height": 420 },
      "maximumSize": { "width": 2000, "height": 3000 },
      "preferredDockedSize": { "width": 360, "height": 700 },
      "preferredFloatingSize": { "width": 420, "height": 760 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel.svg", "scale": [1, 2], "theme": ["all"] }
      ]
    }
  ],
  "icons": [
    { "width": 48, "height": 48, "path": "icons/plugin.svg", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
  ]
}
